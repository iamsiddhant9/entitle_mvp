# --- Core ---
SECRET_KEY=django-insecure-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=*
# Leave DATABASE_URL unset to use a local SQLite file (quick start without Postgres)
DATABASE_URL=postgres://postgres:password@localhost:5432/entitle
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Scheme rules ---
# Defaults to ../docs/rules relative to the backend directory
# RULES_DIR=/docs/rules

# --- Gemini (leave unset to use deterministic template explanations) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Polygon Amoy (leave unset to issue certificates in simulated mode) ---
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
WALLET_PRIVATE_KEY=
ELIGIBILITY_REGISTRY_ADDRESS=
POLYGON_CHAIN_ID=80002
EXPLORER_TX_BASE_URL=https://amoy.polygonscan.com/tx/

# --- Certificates ---
CERTIFICATE_VERIFY_BASE_URL=http://localhost:3000/verify/
