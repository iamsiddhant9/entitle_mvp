SECRET_KEY=django-insecure-entitle-mvp-secret-key-2026
DEBUG=True
DATABASE_URL=postgres://postgres:password@localhost:5432/entitle
# Leaving GEMINI_API_KEY unset (or as this placeholder) disables document extraction.
# The API then reports extraction_status="not_configured" with empty extracted_fields —
# it never substitutes example data for a real document reading.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
WALLET_PRIVATE_KEY=your-funded-wallet-private-key
ELIGIBILITY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Document upload limits. 10 MiB / 50 MP are generous for a photo of a certificate and
# bound per-request memory use. DOCUMENT_BLUR_THRESHOLD is the variance-of-Laplacian
# score below which a document is treated as unreadable (sharp documents measure 50,000+).
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_MAX_IMAGE_PIXELS=50000000
DOCUMENT_BLUR_THRESHOLD=300
