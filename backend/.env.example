SECRET_KEY=django-insecure-entitle-mvp-secret-key-2026
DEBUG=True
DATABASE_URL=postgres://postgres:password@localhost:5432/entitle
# Leaving GEMINI_API_KEY unset (or as this placeholder) disables document extraction.
# The API then reports extraction_status="not_configured" with empty extracted_fields —
# it never substitutes example data for a real document reading.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
# Enables GET /api/health/gemini/, which makes two live Gemini calls to prove a
# deployment can actually reach the API. Unset (the default) the route returns 404.
# Send the value in the X-Healthcheck-Token header.
HEALTHCHECK_TOKEN=
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
WALLET_PRIVATE_KEY=your-funded-wallet-private-key
# Default below is the deterministic address of the FIRST contract deployed to a local
# Hardhat node (see contracts/scripts/deploy.js). It is a local-development convenience,
# NOT a Polygon Amoy deployment — set the real address for any deployed environment.
ELIGIBILITY_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Document upload limits. 10 MiB / 50 MP are generous for a photo of a certificate and
# bound per-request memory use. DOCUMENT_BLUR_THRESHOLD is the variance-of-Laplacian
# score below which a document is treated as unreadable (sharp documents measure 50,000+).
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_MAX_IMAGE_PIXELS=50000000
DOCUMENT_BLUR_THRESHOLD=300

# DigiLocker Configuration
DIGILOCKER_CLIENT_ID=your-client-id
DIGILOCKER_CLIENT_SECRET=your-client-secret
DIGILOCKER_REDIRECT_URI=http://localhost:8000/api/documents/digilocker/callback/
