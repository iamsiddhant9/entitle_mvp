# Polygon Amoy RPC endpoint
# Get a free key at: https://www.alchemy.com/ or use the public RPC below
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of the wallet that will deploy + own the contract.
# Fund it with test MATIC from: https://faucet.polygon.technology/
# ⚠️  NEVER commit a real private key. Use a testnet-only wallet.
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Polygonscan API key for contract verification (optional)
# Get at: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=
